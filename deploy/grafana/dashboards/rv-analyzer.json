{
 "uid": "rv-analyzer",
 "title": "RV Analyzer",
 "tags": [
  "rv-analyzer"
 ],
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Components up",
   "datasource": {
    "type": "prometheus",
    "uid": "rv-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 4
   },
   "targets": [
    {
     "expr": "rv_component_up",
     "legendFormat": "{{component}}",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN"
        },
        "1": {
         "text": "UP"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Ready",
   "datasource": {
    "type": "prometheus",
    "uid": "rv-prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "expr": "rv_ready",
     "legendFormat": "ready",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN"
        },
        "1": {
         "text": "UP"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Version",
   "datasource": {
    "type": "prometheus",
    "uid": "rv-prometheus"
   },
   "gridPos": {
    "x": 15,
    "y": 0,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "expr": "rv_info",
     "legendFormat": "{{version}}",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Analyses in progress",
   "datasource": {
    "type": "prometheus",
    "uid": "rv-prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "expr": "rv_analyses_in_progress",
     "legendFormat": "running",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "AI feedback in progress",
   "datasource": {
    "type": "prometheus",
    "uid": "rv-prometheus"
   },
   "gridPos": {
    "x": 21,
    "y": 0,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "expr": "rv_ai_feedback_in_progress",
     "legendFormat": "running",
     "refId": "A",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value_and_name"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Requests per second (by route)",
   "datasource": {
    "type": "prometheus",
    "uid": "rv-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (route) (rate(rv_http_requests_total[$__rate_interval]))",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Request latency p95 (by route)",
   "datasource": {
    "type": "prometheus",
    "uid": "rv-prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(rv_http_request_duration_seconds_bucket[$__rate_interval])))",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Server errors (5xx)",
   "datasource": {
    "type": "prometheus",
    "uid": "rv-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum(rate(rv_http_requests_total{status=~\"5..\"}[$__rate_interval]))",
     "legendFormat": "5xx/s",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Analyses by outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "rv-prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (status) (increase(rv_analyses_total[$__rate_interval]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "AI feedback duration (avg)",
   "datasource": {
    "type": "prometheus",
    "uid": "rv-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "rate(rv_ai_feedback_duration_seconds_sum[$__rate_interval]) / rate(rv_ai_feedback_duration_seconds_count[$__rate_interval])",
     "legendFormat": "avg",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Bluetooth events (per hour)",
   "datasource": {
    "type": "prometheus",
    "uid": "rv-prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (event) (increase(rv_client_events_total[1h]))",
     "legendFormat": "{{event}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Data volume free space",
   "datasource": {
    "type": "prometheus",
    "uid": "rv-prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "rv_data_volume_free_bytes",
     "legendFormat": "free",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Worker queue depth",
   "datasource": {
    "type": "prometheus",
    "uid": "rv-prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "rv_worker_queue_depth",
     "legendFormat": "{{pool}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   }
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}