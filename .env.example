# Copy to .env and edit. docker compose reads it automatically. Everything is optional.

# --- Port on your machine -------------------------------------------------------------
RV_PORT=8000

# --- Settings page ------------------------------------------------------------------------
# The AI server, image key and tracing endpoint can be entered on the app's Settings page instead of here.
# The compose file lets the page save changes by default (single-machine use). Set false if others can reach the port.
# RV_SETTINGS_EDITABLE=true

# --- Optional compose profiles: docker compose --profile ai|observability up -d ----------------
# RV_OLLAMA_MODEL=llama3.2:3b
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090

# --- Login (strongly recommended if anyone else can reach the port) --------------------
# The app has no accounts. Set both to require a username and password.
RV_AUTH_USER=
RV_AUTH_PASSWORD=

# --- AI coach (needs a running Open WebUI or Ollama) ----------------------------------
# Open WebUI:  RV_AI_BACKEND=openwebui, URL like http://192.168.1.50:3000, plus an API key
#              (Open WebUI > Settings > Account > API Keys).
# Ollama:      RV_AI_BACKEND=ollama,    URL like http://192.168.1.50:11434, no key needed.
# Ollama running on THIS machine: use http://host.docker.internal:11434
RV_AI_BACKEND=openwebui
RV_AI_BASE_URL=
RV_AI_MODEL=
RV_AI_API_KEY=

# --- RV targets -----------------------------------------------------------------------
# Wikimedia Commons works with no key. A free Pexels key (pexels.com/api) adds stock photos.
RV_PEXELS_API_KEY=
# Wikimedia asks API clients to identify themselves: an email address or your repo URL.
RV_CONTACT=

# --- Logging ----------------------------------------------------------------------------
# RV_LOG_FORMAT: json (one object per line, for Loki), text, or auto (json inside Kubernetes).
RV_LOG_LEVEL=INFO
RV_LOG_FORMAT=auto

# --- Tracing (Tempo or any OTLP backend); off unless the endpoint is set -------------------
# Tempo's OTLP ports: 4318 = HTTP (default protocol), 4317 = gRPC (also set the protocol to grpc).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo.monitoring.svc:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=rv-analyzer
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
